name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  backend:
    name: Backend gates
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: apps/backend
    services:
      postgres:
        # pgvector is required by the migrations; the migration and RLS tests
        # run against this database.
        image: pgvector/pgvector:pg16
        env:
          POSTGRES_USER: bolu
          POSTGRES_PASSWORD: bolu_secret
          POSTGRES_DB: bolu
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U bolu -d bolu"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    env:
      DATABASE_URL: postgres://bolu:bolu_secret@localhost:5432/bolu?sslmode=disable
      GOBIN: ${{ github.workspace }}/.bin
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version-file: apps/backend/go.mod
          cache-dependency-path: apps/backend/go.sum

      - name: Install tooling
        # Pinned versions, installed from source so the CI matches the versions
        # the Makefile targets use locally.
        run: |
          go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1
          go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.5.0
          go install github.com/vektra/mockery/v2@v2.53.7
          echo "$GOBIN" >> "$GITHUB_PATH"

      - name: gofmt
        run: |
          unformatted="$(gofmt -l ./cmd ./internal ./migrations ./tools ./test)"
          if [ -n "$unformatted" ]; then
            echo "these files are not formatted:"
            echo "$unformatted"
            exit 1
          fi

      - name: Dependency rules (archcheck)
        run: go run ./tools/archcheck

      - name: golangci-lint
        run: golangci-lint run ./...

      - name: sqlc diff
        # The generated code must stay in sync with the migrations and queries.
        run: |
          sqlc generate
          git diff --exit-code -- internal/modules

      - name: mockery diff
        # The committed mocks must stay in sync with the domain interfaces.
        run: |
          mockery --config .mockery.yaml
          git diff --exit-code -- internal/modules

      - name: Migrations up, down, up
        run: |
          go run ./tools/migrate up
          go run ./tools/migrate down
          go run ./tools/migrate up

      - name: Tests with the race detector
        # The race detector needs cgo, so this step runs with the default
        # CGO_ENABLED=1 and a real Postgres from the service container.
        run: go test ./... -race -count=1

      - name: Coverage gate (80%)
        env:
          CGO_ENABLED: 0
        run: ./scripts/coverage.sh
