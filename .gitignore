# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
coverage.out
coverage.raw

# next.js
.next/
out/

# production
build/

# go
bin/
apps/backend/bin/
