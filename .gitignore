apps/virtual-computer/sandbox/gate/gate

# env files (opt-in for the committed template)
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# omp / agent scratch
omp-*.log
prompts/
