# Copy to .env and adjust. Everything here is a development default; staging and
# production supply their own values through the environment.

# --- Postgres (Jakarta region in production, see docs/adr/0001) ---------------
POSTGRES_USER=employeebot
POSTGRES_PASSWORD=employeebot_secret
POSTGRES_DB=employeebot
POSTGRES_PORT=5432
DATABASE_URL=postgres://employeebot:employeebot_secret@localhost:5432/employeebot?sslmode=disable

# --- Redis: realtime channels, rate limit buckets, live quota counter --------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Temporal ----------------------------------------------------------------
# Local development runs the self-hosted server from docker-compose. Staging and
# production point at Temporal Cloud (Singapore, aws-ap-southeast-1) and add
# TEMPORAL_TLS=true plus TEMPORAL_API_KEY.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_AGENT=bolu-agent
TEMPORAL_TASK_QUEUE_INTEGRATION=bolu-integration
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
# Where the API offers a link to a stuck task's workflow. Empty means no link is shown, which is
# the honest answer when the UI is not reachable from where the person reading is.
TEMPORAL_UI_BASE_URL=http://localhost:8233

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=8080
HTTP_ADDRESS=:8080
ENVIRONMENT=local
JWT_SECRET=change-me-in-production

# --- Auth ---------------------------------------------------------------------
# Whether a new account must confirm its email address before it may use the
# product. It is on in production; a rollout that has not finished its mail path
# sets it to false so registering is the whole of the gate.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=console

# --- Model gateway (LLM) ------------------------------------------------------
# SECRET_ENCRYPTION_KEY seals the provider API keys at rest: 32 bytes, written as
# base64, hex, or 32 raw characters (`openssl rand -base64 32`). An empty value
# lets the API run but refuses to store a provider key.
SECRET_ENCRYPTION_KEY=local_dev_secret_key_32_byte_len
# The provider the platform offers to a workspace that configured none. Leaving
# MODEL empty disables it, so every workspace must configure its own provider.
LLM_DEFAULT_ADAPTER=
LLM_DEFAULT_BASE_URL=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_API_KEY=
# Token allowance: LLM_QUOTA_ENABLED=false skips the pre-flight check locally, and
# LLM_TOKENS_PER_PERIOD=0 means unlimited until the subscription lands (EPIC 12).
LLM_QUOTA_ENABLED=false
LLM_TOKENS_PER_PERIOD=0
LLM_CHAIN_LIMIT=3

# --- WhatsApp gateway (EPIC 9) ------------------------------------------------
# The gateway is its own process because a WhatsApp session is a socket that stays
# open. Nothing here is needed to run the rest of the product: leaving the URL and
# token empty keeps the numbers readable and refuses to link or send.
#
# WA_GATEWAY_URL is how the API reaches the gateway. Compose uses the service
# name; an API run on the host wants http://localhost:8090.
WA_GATEWAY_URL=http://wa-gateway:8090
# WA_API_URL is the reverse direction: how the gateway reaches the API's internal
# seam — the effects a product owns (recording an inbound message, claiming the
# outbox, reporting a number's status). Compose uses the API's service name; a
# gateway run on the host wants http://localhost:8091.
WA_API_URL=http://api:8091
# The shared secret between the two processes. The gateway answers anybody who can
# reach it without one, so it refuses to start when this is empty.
WA_GATEWAY_TOKEN=local_dev_wa_gateway_token
# Where the gateway listens. It is not a public address.
WA_ADDRESS=:8090
# Names this instance in the session lease. Leave empty for a single instance;
# a fleet sets a stable name per instance, because a name that changes on every
# start looks like a new claimant and delays every takeover.
WA_OWNER=
# The default send ceiling of a number, in messages per hour. Zero takes the
# product default of forty. There is no blast: the ceiling is per number and the
# queue paces what is under it.
WA_HOURLY_LIMIT=0
# whatsmeow's own protocol log. It writes a line per decrypted message, so it is a
# debugging switch rather than a default.
WA_LOG_WHATSMEOW=false

# --- Virtual computer (PoC, ADR 0003) -----------------------------------------
# One sandbox per bot, driven by a control plane on the internal network. Nothing
# here is needed to run the product: an empty URL is a deployment without a virtual
# computer, and the Temporal activities then answer ErrNotConfigured instead of
# calling an address nobody meant.
#
# VCOMPUTER_CONTROL_URL is an *internal* address — the control plane speaks for every
# bot at once and is never published, so a caller that reached it from outside could
# drive any bot's desktop. From the compose network it is the service name; a control
# plane run on the host is reached at http://localhost:8090 (its port is bound to
# loopback only).
VCOMPUTER_CONTROL_URL=
# The shared secret every /v1 route requires. It must be the same value the control
# plane was started with (its own VCOMPUTER_CONTROL_TOKEN); a mismatch comes back as
# a 401 that says the token is not valid, and the worker reports it as a configuration
# mistake and stops rather than retrying the header the control plane just refused.
# An address with no token at all is a warning at startup, and every call is refused
# with a 401 that says no credential arrived, so the two mistakes read differently.
VCOMPUTER_CONTROL_TOKEN=
# Bounds one call to the control plane. A screenshot of a cold sandbox includes the
# container starting, so this is generous rather than tight.
VCOMPUTER_CONTROL_TIMEOUT=30s

# --- Plan limits --------------------------------------------------------------
# The cost ceiling of one day per workspace, in micro-rupiah (1 IDR = 1e6). Zero
# means unlimited. It is the second bound the quota asks, alongside the period's
# token allowance.
PLAN_DAILY_COST_MICROS=0

# --- Task runtime -------------------------------------------------------------
# What one task may spend before it stops with a reason the user can read. A zero
# falls back to the product default.
TASK_MAX_STEPS=12
TASK_MAX_TOKENS=120000
TASK_MAX_HANDOFF_DEPTH=2
TASK_MAX_TOOL_RESULT_BYTES=16384

# --- Memory & knowledge (EPIC 10) ---------------------------------------------
# The workspace memory is sent on every call, so the cap is in tokens. Pinned
# memories come first, and a memory that does not fit is skipped rather than cut.
MEMORY_MAIN_TOKENS=1500
# How many chunks one round retrieves, and how close a match has to be to replace
# an existing memory instead of joining it.
MEMORY_RECALL_MEMORIES=6
MEMORY_RECALL_KNOWLEDGE=4
MEMORY_SIMILARITY=0.90
# How long a conversation must not move before it is read into memory.
MEMORY_QUIET_SECONDS=300
MEMORY_EXTRACTION_MESSAGES=30
# One knowledge chunk, and how much of its end repeats at the start of the next.
MEMORY_CHUNK_RUNES=1000
MEMORY_CHUNK_OVERLAP_RUNES=150
MEMORY_MAX_CONTENT_RUNES=2000

# --- Object storage -----------------------------------------------------------
# Attachments and sandboxed HTML documents. Development uses the local driver (a
# directory); deployments use the S3 API, which MinIO, R2, B2, and AWS all speak.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=bolu
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
S3_PATH_STYLE=true
# Where sandboxed HTML documents are served from. It must be a different origin
# from the app in production; locally the API serves them itself.
CONTENT_ORIGIN=http://localhost:8080
# Which origins may frame a content document, comma separated. It is the app's
# own origin: naming it is required, because `frame-ancestors 'self'` would
# refuse the frame whenever the content origin is a different host.
CONTENT_FRAME_ANCESTORS=http://localhost:3000
# Which file types a chat upload may be, by extension, comma separated. It can
# only narrow the chat module's default list: an extension the module has no
# content rule for is ignored and an executable can never be named. Empty means
# the default list (images, PDFs, office documents, and text).
ATTACHMENT_ALLOWED_EXTENSIONS=

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Whether the sign-in pages offer Google. Off unless a deployment has registered
# a Google client, because the button is inlined at build time and a button that
# leads nowhere is worse than none.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# Billing: the package, the allowance, and how it is paid for. Leaving
# DUITKU_MERCHANT_CODE and DUITKU_API_KEY empty keeps the module on and its online
# payment off: an invoice is written and the screen says to transfer and confirm,
# which is how the first customers pay.
BILLING_PROVIDER=
# Duitku: the merchant code identifies the project, and the API key signs the inquiry
# and verifies the payment callback — it is the whole security of that route.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Explicit: a sandbox key against the production host is a charge on somebody's card.
DUITKU_SANDBOX=true
# Duitku's own payment-channel code. Empty takes a bank virtual account.
DUITKU_PAYMENT_METHOD=
DUITKU_EXPIRY_MINUTES=0
# Required to take payment at all: Duitku posts the payment notification here and reaches
# it from outside, so it has to be a public address this deployment serves.
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=
# Empty follows DUITKU_SANDBOX. A sandbox run verifying its own wiring points this at a
# stand-in rather than at Duitku.
DUITKU_BASE_URL=
# Zero takes the product default of a week.
BILLING_GRACE_DAYS=0
BILLING_SYNC_INTERVAL=15m
BILLING_SWEEP_INTERVAL=15m

# --- Operations ---------------------------------------------------------------
# Where a process with no HTTP API of its own serves /health, /ready, and /metrics. The API
# answers on its own listener; the workers and the gateway have none, and an orchestrator needs
# something to probe. Empty means the process serves none.
OPS_ADDRESS=
# INTERNAL_ADDRESS is where the API serves the gateway's own calls — the seam the gateway
# reaches through WA_API_URL. It speaks for every tenant with one shared secret, so it is
# never published. Empty means the API serves no internal listener, which is what a
# deployment without a gateway wants.
INTERNAL_ADDRESS=

# --- Integrations: the connectors a workspace can connect (EPIC 7/8) -----------
# A connector is offered only when the deployment registered an OAuth application
# for it: leaving a client id and secret empty disables that connector rather than
# offering it and failing at the consent screen. The sign-in flow's Google client
# is a different application from the Gmail connector's, because a person signing
# in and a workspace connecting a mailbox are different consents.
#
# OAUTH_STATE_KEY signs the value an authorization flow carries. It travels through
# a browser, so a guessable signature is a forged callback: at least 32 characters,
# and empty disables every connection flow.
OAUTH_STATE_KEY=local_dev_oauth_state_key_32_bytes
# OAUTH_REDIRECT_BASE is the public origin providers redirect back to. It has to be
# the address registered with the provider, so it is configured rather than derived
# from the request. The callback path is the same for every connector:
# /api/integrations/oauth/callback.
OAUTH_REDIRECT_BASE=http://localhost:8080
# KMS_MASTER_KEY wraps the per-workspace data key that seals a connection's token.
# Empty leaves integrations read-only, because no token could be sealed.
KMS_MASTER_KEY=local_dev_kms_master_key_32_bytes
KMS_MASTER_KEY_ID=local
# The pace every connector is held to, and the per-app overrides as `app:perMinute`
# pairs separated by commas. Zero means unlimited, which is what a deployment
# without Redis runs with.
INTEGRATION_CALLS_PER_MINUTE=0
INTEGRATION_RATE_LIMITS=
# GMAIL_*, SLACK_*, and GITHUB_* are the connectors' own OAuth applications.
# GMAIL_API_BASE, GMAIL_AUTH_ENDPOINT, GMAIL_TOKEN_ENDPOINT — and the same three
# for SLACK_ and GITHUB_ — point a connector somewhere other than the provider, so
# a smoke test can run the whole path without a real account. Empty means the
# provider's own address.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_API_BASE=
GMAIL_AUTH_ENDPOINT=
GMAIL_TOKEN_ENDPOINT=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_API_BASE=
SLACK_AUTH_ENDPOINT=
SLACK_TOKEN_ENDPOINT=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_BASE=
GITHUB_AUTH_ENDPOINT=
GITHUB_TOKEN_ENDPOINT=
# MCP_TIMEOUT bounds one request to an MCP server. A task is blocked while it runs,
# so a server that does not answer within it is treated as unavailable. The servers
# themselves are added per workspace through /api/mcp/servers, not from here.
MCP_TIMEOUT=30s

# --- Telemetry (EPIC 13) ------------------------------------------------------
# Where this deployment's traces go. The default is nowhere, and that is deliberate:
# a deployment that has not said where telemetry should be sent should not be
# sending it. The tracer provider is installed either way, so a request still has a
# trace id its log lines carry and an incoming trace is joined rather than broken.
#
# "none" drops the spans and keeps the trace ids, "console" prints them for a
# development run, "otlp" sends them to a collector.
OTEL_EXPORTER=none
# The collector's host:port, required by the otlp exporter and ignored by the others.
OTEL_ENDPOINT=
# Empty, so each binary names itself: the API and the workers are separate services
# in a collector rather than one process that appears everywhere.
OTEL_SERVICE_NAME=
# The share of root traces kept, between 0 and 1. A trace a caller already sampled
# is always kept — dropping it would leave a trace with a hole where the work was.
OTEL_SAMPLE_RATIO=1.0
# Drops TLS to the collector, which is what a collector on the compose network wants.
OTEL_INSECURE=false

# Where the deployment's measurements go, and how often a pushing exporter sends them.
# A separate switch from the traces, because the two are asked for separately in practice.
#
# "prometheus" serves them at /metrics for a scraper; "otlp" pushes them to a collector;
# "console" prints them for a development run.
OTEL_METRICS_EXPORTER=none
OTEL_METRICS_ENDPOINT=
OTEL_METRICS_INTERVAL=60s


# --- Retention (EPIC 13) ------------------------------------------------------
# What the deployment keeps, and for how long. The split is the design: a task
# step's *shape* — which tool, how many tokens, when it ran — is kept for good,
# and its raw payload is not.
#
# RETENTION_STEP_DAYS=30 prunes the raw input and output of a step thirty days
# after it ran. Zero takes the same thirty-day default.
RETENTION_STEP_DAYS=30
# Zero keeps an attachment as long as the message that carries it, which is a
# deployment with no attachment policy. It is not a window of zero seconds.
RETENTION_ATTACHMENT_DAYS=0
# How often the pass runs, and how much it removes in one go. RETENTION_INTERVAL=0
# disables the job, which is what local development wants: a stack somebody is
# stepping through should not lose the payload they are reading.
RETENTION_INTERVAL=6h
# How much one pass removes from one workspace, and how many workspaces it looks
# at. A bound rather than a policy: the same batch every pass is what keeps a
# deployment with years of history from removing a month of storage at once.
RETENTION_BATCH=500
RETENTION_SWEEP_LIMIT=200
