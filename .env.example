# Copy to .env and adjust. Everything here is a development default; staging and
# production supply their own values through the environment.

# --- Postgres (Jakarta region in production, see docs/adr/0001) ---------------
POSTGRES_USER=employeebot
POSTGRES_PASSWORD=employeebot_secret
POSTGRES_DB=employeebot
POSTGRES_PORT=5432
DATABASE_URL=postgres://employeebot:employeebot_secret@localhost:5432/employeebot?sslmode=disable

# --- Redis: realtime channels, rate limit buckets, live quota counter --------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Temporal ----------------------------------------------------------------
# Local development runs the self-hosted server from docker-compose. Staging and
# production point at Temporal Cloud (Singapore, aws-ap-southeast-1) and add
# TEMPORAL_TLS=true plus TEMPORAL_API_KEY.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_AGENT=bolu-agent
TEMPORAL_TASK_QUEUE_INTEGRATION=bolu-integration
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=8080
HTTP_ADDRESS=:8080
ENVIRONMENT=local
JWT_SECRET=change-me-in-production

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=console

# --- Model gateway (LLM) ------------------------------------------------------
# SECRET_ENCRYPTION_KEY seals the provider API keys at rest: 32 bytes, written as
# base64, hex, or 32 raw characters (`openssl rand -base64 32`). An empty value
# lets the API run but refuses to store a provider key.
SECRET_ENCRYPTION_KEY=local_dev_secret_key_32_byte_len
# The provider the platform offers to a workspace that configured none. Leaving
# MODEL empty disables it, so every workspace must configure its own provider.
LLM_DEFAULT_ADAPTER=
LLM_DEFAULT_BASE_URL=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_API_KEY=
# Token allowance: LLM_QUOTA_ENABLED=false skips the pre-flight check locally, and
# LLM_TOKENS_PER_PERIOD=0 means unlimited until the subscription lands (EPIC 12).
LLM_QUOTA_ENABLED=false
LLM_TOKENS_PER_PERIOD=0
LLM_CHAIN_LIMIT=3

# --- WhatsApp gateway (EPIC 9) ------------------------------------------------
# The gateway is its own process because a WhatsApp session is a socket that stays
# open. Nothing here is needed to run the rest of the product: leaving the URL and
# token empty keeps the numbers readable and refuses to link or send.
#
# WA_GATEWAY_URL is how the API reaches the gateway. Compose uses the service
# name; an API run on the host wants http://localhost:8090.
WA_GATEWAY_URL=http://wa-gateway:8090
# The shared secret between the two processes. The gateway answers anybody who can
# reach it without one, so it refuses to start when this is empty.
WA_GATEWAY_TOKEN=local_dev_wa_gateway_token
# Where the gateway listens. It is not a public address.
WA_ADDRESS=:8090
# Names this instance in the session lease. Leave empty for a single instance;
# a fleet sets a stable name per instance, because a name that changes on every
# start looks like a new claimant and delays every takeover.
WA_OWNER=
# The default send ceiling of a number, in messages per hour. Zero takes the
# product default of forty. There is no blast: the ceiling is per number and the
# queue paces what is under it.
WA_HOURLY_LIMIT=0
# whatsmeow's own protocol log. It writes a line per decrypted message, so it is a
# debugging switch rather than a default.
WA_LOG_WHATSMEOW=false

# --- Plan limits --------------------------------------------------------------
# The cost ceiling of one day per workspace, in micro-rupiah (1 IDR = 1e6). Zero
# means unlimited. It is the second bound the quota asks, alongside the period's
# token allowance.
PLAN_DAILY_COST_MICROS=0

# --- Task runtime -------------------------------------------------------------
# What one task may spend before it stops with a reason the user can read. A zero
# falls back to the product default.
TASK_MAX_STEPS=12
TASK_MAX_TOKENS=120000
TASK_MAX_HANDOFF_DEPTH=2
TASK_MAX_TOOL_RESULT_BYTES=16384

# --- Memory & knowledge (EPIC 10) ---------------------------------------------
# The workspace memory is sent on every call, so the cap is in tokens. Pinned
# memories come first, and a memory that does not fit is skipped rather than cut.
MEMORY_MAIN_TOKENS=1500
# How many chunks one round retrieves, and how close a match has to be to replace
# an existing memory instead of joining it.
MEMORY_RECALL_MEMORIES=6
MEMORY_RECALL_KNOWLEDGE=4
MEMORY_SIMILARITY=0.90
# How long a conversation must not move before it is read into memory.
MEMORY_QUIET_SECONDS=300
MEMORY_EXTRACTION_MESSAGES=30
# One knowledge chunk, and how much of its end repeats at the start of the next.
MEMORY_CHUNK_RUNES=1000
MEMORY_CHUNK_OVERLAP_RUNES=150
MEMORY_MAX_CONTENT_RUNES=2000

# --- Object storage -----------------------------------------------------------
# Attachments and sandboxed HTML documents. Development uses the local driver (a
# directory); deployments use the S3 API, which MinIO, R2, B2, and AWS all speak.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=bolu
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=false
S3_PATH_STYLE=true
# Where sandboxed HTML documents are served from. It must be a different origin
# from the app in production; locally the API serves them itself.
CONTENT_ORIGIN=http://localhost:8080
# Which origins may frame a content document, comma separated. It is the app's
# own origin: naming it is required, because `frame-ancestors 'self'` would
# refuse the frame whenever the content origin is a different host.
CONTENT_FRAME_ANCESTORS=http://localhost:3000

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
